{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build-local": "tsc -b && vite build --outDir ../backend/server/dist --emptyOutDir true",
    "build-prod": "tsc -b && vite build --outDir ../backend/server/dist --emptyOutDir true --mode prod",
    "preview": "vite preview",
    "generate": "openapi-typescript ../backend/openapi.yml -o ./src/api/schema.d.ts"
  },
  "dependencies": {
    "@solidjs/router": "^0.15.3",
    "@tailwindcss/vite": "^4.1.11",
    "openapi-fetch": "^0.14.0",
    "solid-js": "^1.9.7",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "openapi-typescript": "^7.8.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-solid": "^2.11.7"
  }
}
